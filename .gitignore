# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/

# FORGE generated validation evidence
/governance/validation/*.json
/governance/validation/*.tmp

# Supabase local CLI metadata
supabase/.temp/

# FB-UI-1 screenshot evidence output -- may contain synthetic-data screenshots and manifests from
# local runs; never committed (requirement 9: never commit a screenshot with real borrower/tenant/
# financial/auth/payment information -- the safest default is to never commit the output at all).
/ui-improvement-manager/evidence/
