{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "height": 680,
        "label": "main",
        "minHeight": 600,
        "minWidth": 480,
        "resizable": true,
        "title": "FORGE Capture",
        "width": 560
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "longDescription": "FORGE Capture is a local-first screen capture utility: full monitor, window, region, and delayed captures with no account and no upload.",
    "shortDescription": "Native screen capture for FORGE",
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "identifier": "online.409marketplace.forge.capture",
  "productName": "FORGE Capture",
  "version": "0.2.0"
}
