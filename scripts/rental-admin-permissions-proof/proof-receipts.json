  "has_workspace_access_live_shape": [
    {
      "definition": "CREATE OR REPLACE FUNCTION public.has_workspace_access(p_owner_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\n SET row_security TO 'off'\nAS $function$\n    select p_owner_id = auth.uid()::text\n        or exists (\n            select 1 from workspace_members\n            where owner_id = p_owner_id\n              and member_user_id = auth.uid()\n              and status = 'active'\n              and role = 'co_owner'\n        );\n$function$\n"
    }
  ]
